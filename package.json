{
  "name": "frame-suite",
  "version": "1.0.4",
  "description": "decky-lsfg-vk, Decky-Framegen and HelixSR Manager in one Decky plugin, with a per-game switch for your chip",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch": "node scripts/upstreams.mjs fetch",
    "check-upstreams": "node scripts/upstreams.mjs check",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "license": "MIT",
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  }
}
